{
  "datasets": [
    {
      "name": "f0b23e9e",
      "displayName": "Business snapshots",
      "queryLines": [
        "-- Load business snapshots from Gold for dashboard analysis.\r\n",
        "SELECT\r\n",
        "    run_id,\r\n",
        "    business_key,\r\n",
        "    place_id,\r\n",
        "    business_name,\r\n",
        "        -- Translate analytical category labels for dashboard display.\r\n",
        "    CASE primary_category_name\r\n",
        "        WHEN 'Cafeterías' THEN 'Cafes'\r\n",
        "        WHEN 'Restaurantes' THEN 'Restaurants'\r\n",
        "        WHEN 'Bares y pubs' THEN 'Bars & Pubs'\r\n",
        "        WHEN 'Discotecas' THEN 'Nightclubs'\r\n",
        "        WHEN 'Gimnasios' THEN 'Gyms'\r\n",
        "        WHEN 'Peluquerías y barberías' THEN 'Hair Salons & Barbers'\r\n",
        "        WHEN 'Veterinarias y cuidado de mascotas' THEN 'Veterinary & Pet Care'\r\n",
        "        WHEN 'Por clasificar' THEN 'Unclassified'\r\n",
        "        ELSE primary_category_name\r\n",
        "    END AS primary_category_name,\r\n",
        "    zone_name,\r\n",
        "    business_status,\r\n",
        "    rating,\r\n",
        "    review_count,\r\n",
        "        -- Group review counts into selectable ranges without excluding large values.\r\n",
        "    CASE\r\n",
        "        WHEN review_count IS NULL THEN '07 - Not reported'\r\n",
        "        WHEN review_count = 0 THEN '01 - No reviews'\r\n",
        "        WHEN review_count <= 10 THEN '02 - 1–10'\r\n",
        "        WHEN review_count <= 50 THEN '03 - 11–50'\r\n",
        "        WHEN review_count <= 200 THEN '04 - 51–200'\r\n",
        "        WHEN review_count <= 1000 THEN '05 - 201–1,000'\r\n",
        "        ELSE '06 - Over 1,000'\r\n",
        "    END AS review_count_band,\r\n",
        "    -- Flag businesses with at least one reported review for percentage calculations.\r\n",
        "    CASE WHEN review_count > 0 THEN 1.0 ELSE 0.0 END AS with_reviews_flag,\r\n",
        "    -- Flag businesses whose review count was not reported.\r\n",
        "    CASE WHEN review_count IS NULL THEN 1 ELSE 0 END AS missing_review_count_flag,\r\n",
        "        -- Translate price-level labels for dashboard display.\r\n",
        "    CASE price_level_name\r\n",
        "        WHEN 'Gratuito' THEN 'Free'\r\n",
        "        WHEN 'Económico' THEN 'Inexpensive'\r\n",
        "        WHEN 'Moderado' THEN 'Moderate'\r\n",
        "        WHEN 'Costoso' THEN 'Expensive'\r\n",
        "        WHEN 'Muy costoso' THEN 'Very Expensive'\r\n",
        "        WHEN 'Sin especificar' THEN 'Unspecified'\r\n",
        "        WHEN 'No reportado' THEN 'Not Reported'\r\n",
        "        ELSE price_level_name\r\n",
        "    END AS price_level_name,\r\n",
        "    price_order,\r\n",
        "    -- Convert reported website availability into a numeric indicator.\r\n",
        "    CASE WHEN has_website THEN 1.0 ELSE 0.0 END AS website_reported_flag,\r\n",
        "    -- Convert reported phone and opening-hours availability into numeric indicators.\r\n",
        "    CASE WHEN has_phone THEN 1.0 ELSE 0.0 END AS phone_reported_flag,\r\n",
        "    CASE WHEN has_opening_hours THEN 1.0 ELSE 0.0 END AS hours_reported_flag,\r\n",
        "    has_website,\r\n",
        "    has_phone,\r\n",
        "    has_opening_hours,\r\n",
        "    website_uri,\r\n",
        "    national_phone_number,\r\n",
        "    google_maps_uri,\r\n",
        "    write_review_uri\r\n",
        "FROM places_ratings.gold.v_business_explorer;"
      ]
    }
  ],
